# Server
PORT=5000
NODE_ENV=development
# Frontend origin allowed to call the API with cookies (dev Vite server)
CLIENT_URL=http://localhost:5173

# Employee ID company prefix (e.g. OIJODO20220001)
COMPANY_CODE=OI

# Database
DATABASE_URL=mongodb://localhost:27017/dayflow

# Auth — access token sent as Bearer header (expires in minutes),
# refresh token kept in an httpOnly cookie (expires in days)
JWT_ACCESS_SECRET=generate-with-node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
JWT_REFRESH_SECRET=generate-a-different-random-hex
JWT_ACCESS_EXPIRES_MINUTES=15
JWT_REFRESH_EXPIRES_DAYS=7
